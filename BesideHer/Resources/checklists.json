{
  "checklists": [
    {
      "id": "checklist-t1",
      "title": "First Trimester Checklist",
      "trimester": 1,
      "items": [
        {
          "id": "t1-c1",
          "text": "Schedule and attend first prenatal appointment (weeks 8-10)",
          "category": "medical",
          "weekRecommended": 8
        },
        {
          "id": "t1-c2",
          "text": "Discuss genetic screening options (NIPT, NT scan) with partner",
          "category": "medical",
          "weekRecommended": 10
        },
        {
          "id": "t1-c3",
          "text": "Begin taking prenatal vitamins (600 mcg folic acid, 27 mg iron)",
          "category": "health",
          "weekRecommended": 4
        },
        {
          "id": "t1-c4",
          "text": "Review health insurance \u2014 deductibles, copays, out-of-pocket max",
          "category": "financial",
          "weekRecommended": 9
        },
        {
          "id": "t1-c5",
          "text": "Start building emergency fund (target: 6 months expenses)",
          "category": "financial",
          "weekRecommended": 6
        },
        {
          "id": "t1-c6",
          "text": "Research car seats, cribs, and strollers",
          "category": "gear",
          "weekRecommended": 11
        },
        {
          "id": "t1-c7",
          "text": "Discuss when to share pregnancy news with family",
          "category": "emotional",
          "weekRecommended": 8
        },
        {
          "id": "t1-c8",
          "text": "Learn foods to avoid and adjust household meals",
          "category": "health",
          "weekRecommended": 5
        },
        {
          "id": "t1-c9",
          "text": "Practice active listening and emotional support techniques",
          "category": "emotional",
          "weekRecommended": 6
        },
        {
          "id": "t1-c10",
          "text": "Research your employer's paternity leave policy",
          "category": "planning",
          "weekRecommended": 9
        },
        {
          "id": "t1-c11",
          "text": "Get term life insurance quotes from at least 3 providers",
          "category": "financial",
          "weekRecommended": 10
        },
        {
          "id": "t1-c12",
          "text": "Start a pregnancy budget spreadsheet",
          "category": "financial",
          "weekRecommended": 8
        }
      ]
    },
    {
      "id": "checklist-t2",
      "title": "Second Trimester Checklist",
      "trimester": 2,
      "items": [
        {
